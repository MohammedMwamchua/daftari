DEBUG=1
# Signs every sign-in token. start.bat fills in a random one; make your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Proxies in front of Django that add the visitor's address (1 for the Vite dev server)
TRUSTED_PROXIES=1
POSTGRES_DB=daftari
POSTGRES_USER=daftari
POSTGRES_PASSWORD=daftari
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CORS_ORIGINS=http://localhost:5173
# USE_SQLITE=1   # run without PostgreSQL
# BACKUP_DIR=C:\Users\you\OneDrive\Daftari backups   # where backup_db saves copies (default: ./backups)
